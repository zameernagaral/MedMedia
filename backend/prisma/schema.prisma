datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                 String             @id @default(uuid())
  email              String?            @unique
  phoneNumber        String?            @unique
  passwordHash       String?
  googleId           String?            @unique
  fullName           String
  username           String             @unique
  avatarUrl          String?
  role               String             @default("STUDENT")
  verificationStatus String             @default("PENDING")
  bio                String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  doctorProfile      DoctorProfile?
  studentProfile     StudentProfile?
  sessions           DeviceSession[]
  posts              Post[]
  medclips           Medclip[]
  jobApplications    JobApplication[]
  stories            Story[]
  communitiesOwned   Community[]
}

model DoctorProfile {
  id                      String    @id @default(uuid())
  userId                  String    @unique
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialization          String
  qualifications          String
  hospitalAffiliation     String
  location                String
  yearsExperience         Int       @default(0)
  clinicalInterests       String
  researchPublications    String
  medicalCouncilRegNumber String
  verifiedAt              DateTime?
}

model StudentProfile {
  id               String          @id @default(uuid())
  userId           String          @unique
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  discipline       String
  collegeName      String
  academicYear     Int
  interests        String
  futureSpecialty  String?
  researchInterests String
  verifiedAt       DateTime?
}

model DeviceSession {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceName   String
  deviceOs     String
  ipAddress    String?
  refreshToken String
  lastActive   DateTime @default(now())
  isRevoked    Boolean  @default(false)
  createdAt    DateTime @default(now())
}

model Post {
  id             String    @id @default(uuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  postType       String    @default("TEXT")
  content        String
  mediaUrls      String
  linkUrl        String?
  clinicalTags   String
  likesCount     Int       @default(0)
  commentsCount  Int       @default(0)
  savesCount     Int       @default(0)
  sharesCount    Int       @default(0)
  createdAt      DateTime  @default(now())
}

model Medclip {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clipType         String   @default("Clinical Update")
  videoUrl         String
  thumbnailUrl     String?
  caption          String
  clinicalCategory String
  tags             String
  viewsCount       Int      @default(0)
  likesCount       Int      @default(0)
  commentsCount    Int      @default(0)
  savesCount       Int      @default(0)
  createdAt        DateTime @default(now())
}

model Job {
  id                     String           @id @default(uuid())
  title                  String
  category               String
  employmentType         String
  companyName            String
  location               String
  requiredExperienceYears Int             @default(0)
  salaryRange            String?
  jobDescription         String
  educationPreference    String
  skillsRequired         String
  isActive               Boolean          @default(true)
  createdAt              DateTime         @default(now())
  applications           JobApplication[]
}

model JobApplication {
  id          String   @id @default(uuid())
  jobId       String
  job         Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  applicantId String
  applicant   User     @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  resumeUrl   String?
  status      String   @default("SUBMITTED")
  appliedAt   DateTime @default(now())
}

model Community {
  id               String   @id @default(uuid())
  name             String
  iconUrl          String?
  avatarUrl        String?
  description      String
  category         String
  membersCount     Int      @default(1)
  maxCapacity      Int      @default(10000)
  creatorId        String
  creator          User     @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  isOfficial       Boolean  @default(false)
  announcementText String?
  createdAt        DateTime @default(now())
}

model Story {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mediaUrl    String
  caption     String
  isVideo     Boolean  @default(false)
  clinicalTags String?
  isViewed    Boolean  @default(false)
  createdAt   DateTime @default(now())
  expiresAt   DateTime
}

model ResearchProject {
  id              String   @id @default(uuid())
  title           String
  field           String
  phase           String
  leadInvestigator String
  institution     String
  description     String
  createdAt       DateTime @default(now())
}

model LocumGig {
  id            String   @id @default(uuid())
  title         String
  hospital      String
  location      String
  duration      String
  payRate       String
  requirements  String
  createdAt     DateTime @default(now())
}

model Scholarship {
  id          String   @id @default(uuid())
  title       String
  amount      String
  deadline    String
  institution String
  description String
  createdAt   DateTime @default(now())
}

model Course {
  id          String   @id @default(uuid())
  title       String
  instructor  String
  duration    String
  institution String
  description String
  createdAt   DateTime @default(now())
}
