DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE_NAME"
JWT_SECRET="replace-with-a-random-secret-at-least-32-characters-long"
NODE_ENV="development"
PORT="5001"
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
USE_REDIS="false"
# Demo seed scripts always refuse production. In local development, enable them
# only when required by setting ALLOW_DEMO_SEED=true and a private 16+ character
# DEMO_SEED_PASSWORD. Never reuse a real account password.
# ALLOW_DEMO_SEED=false
# DEMO_SEED_PASSWORD=
# Set CLOUDINARY_URL for persistent media storage; production uploads are disabled without it.
# CLOUDINARY_URL="cloudinary://API_KEY:API_SECRET@CLOUD_NAME"
# Set this to the final public HTTPS origin after domain deployment to enable robots.txt sitemap discovery.
# PUBLIC_SITE_URL=https://your-domain.example
# Low-volume transactional ticket alerts use Resend. Verify the sending domain
# and set these values after buying/configuring a domain and inbox.
# Ticket text is deliberately excluded from notifications.
# RESEND_API_KEY=
# EMAIL_FROM="MedMedia Support <support@your-domain.example>"
# SUPPORT_EMAIL=your-inbox@example.com
# Optional when USE_REDIS=true:
# REDIS_URL="redis://HOST:PORT"
